# Copia este archivo como BACKEND/.env y completa los valores. Nunca subas el .env al repositorio.

PORT=3000

# Base de datos MySQL 8 (crea las tablas con db/schema.sql y los datos demo con db/seed.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=happypet
DB_PASSWORD=
DB_NAME=gestion_mascotas
# Solo para bases en la nube que exigen TLS (Aiven): pega el certificado CA en formato PEM
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Clave para firmar los tokens de sesión: mínimo 32 caracteres aleatorios.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173
